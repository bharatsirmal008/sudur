{
    "buildCommand": "next build",
    "installCommand": "npm install",
    "framework": "nextjs",
    "regions": [
        "sin1"
    ],
    "rewrites": [
        {
            "source": "/api/:path((?!auth).*)",
            "destination": "https://your-backend-url.onrender.com/api/:path*"
        }
    ]
}